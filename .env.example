# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_API_KEY: Optional API Key required in 'x-api-key' header for app authentication.
APP_API_KEY=""

# VITE_APP_API_KEY: Debe tener el MISMO valor que APP_API_KEY.
# Al estar prefijada con VITE_*, queda visible en el bundle del cliente (sirve para filtrar tráfico automatizado sin la key).
VITE_APP_API_KEY=""

# PORT: Server listening port (default 3000)
PORT=3000

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RATE_LIMIT_MAX: Max requests per window for API endpoints (default 100)
RATE_LIMIT_MAX=100
